{
  "name": "pedmesa-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && biome check --error-on-warnings",
    "format": "biome check --write",
    "lint": "biome lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "axios": "^1.21.1",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.2"
  },
  "engines": {
    "node": ">=26"
  }
}
